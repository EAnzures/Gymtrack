{
  "name": "gymtrack-nutricion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "node scripts/serve.mjs",
    "native:prepare": "node scripts/prepare-native.mjs",
    "ios:sync": "npm run native:prepare && cap sync ios && node scripts/verify-native.mjs",
    "ios:open": "cap open ios",
    "ios:ipa": "npm run ios:sync && node scripts/build-ios-ipa.mjs"
  },
  "engines": { "node": ">=22" },
  "overrides": {
    "xcode": { "uuid": "11.1.1" }
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "^1.64.1",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3"
  }
}
